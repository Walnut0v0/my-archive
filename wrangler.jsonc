{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-archive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archive-db",
      "database_id": "d9e8d3b9-95d4-4008-978a-7b388aa0dc40",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "archive-images" }],
  "vars": {},
}
